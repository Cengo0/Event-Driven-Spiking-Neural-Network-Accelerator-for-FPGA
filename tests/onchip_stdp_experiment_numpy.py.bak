#!/usr/bin/env python3
"""
On-Chip STDP Experiment: Bit-Accurate HLS Learning Engine Simulation
=====================================================================

This script simulates the EXACT behavior of the HLS on-chip STDP engine
(hardware/hls/src/snn_top_hls.cpp) in Python, then trains on MNIST to
measure what accuracy the hardware learning engine would achieve.

Key HLS architecture constraints modeled:
  1. Signed 8-bit weights [-128, 127] (weight_t = ap_int<8>)
  2. Per-neuron traces: O(N+M) NOT per-synapse O(N*M)
  3. Mozafari weight-dependent STDP:
     - LTP: Δw = +a_plus * (w_max - w) * pre_trace
     - LTD: Δw = -a_minus * (w - w_min) * post_trace
  4. Exponential decay LUT (16 entries, lazy timestamp-based)
  5. R-STDP: per-neuron eligibility traces, reward modulation
  6. Delta-sigma encoder for spike generation

This is NOT software STDP reimplemented — it is a cycle-approximate
model of snn_top_hls.cpp::process_pre_spike_aer, process_post_spike_aer,
apply_rstdp_reward, and decay_eligibility_traces.

Usage:
    python tests/onchip_stdp_experiment.py                 # Default
    python tests/onchip_stdp_experiment.py --neurons 10    # 10/class
    python tests/onchip_stdp_experiment.py --rstdp         # Enable R-STDP

Author: Jiwoon Lee (@metr0jw)
"""

import sys, os, time, argparse
import numpy as np

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))


# =====================================================================
# HLS Constants (from snn_top_hls.h and snn_params.h)
# =====================================================================

MAX_WEIGHT = 127       # ap_int<8> max
MIN_WEIGHT = -128      # ap_int<8> min
WEIGHT_SCALE = 128

# Exponential Decay LUT (from snn_top_hls.cpp lines 133-150)
EXP_DECAY_LUT = np.array([
    255,  # dt=0:  exp(0) = 1.0
    223,  # dt=1:  ~0.875
    195,  # dt=2:  ~0.765
    170,  # dt=3:  ~0.670
    149,  # dt=4:  ~0.585
    130,  # dt=5:  ~0.512
    114,  # dt=6:  ~0.448
    100,  # dt=7:  ~0.392
    87,   # dt=8:  ~0.343
    76,   # dt=9:  ~0.300
    67,   # dt=10: ~0.262
    58,   # dt=11: ~0.229
    51,   # dt=12: ~0.200
    45,   # dt=13: ~0.175
    39,   # dt=14: ~0.153
    34    # dt=15: ~0.134
], dtype=np.int32)


# =====================================================================
# Bit-Accurate HLS STDP Engine Simulator
# =====================================================================

class HLSSTDPEngine:
    """
    Bit-accurate simulation of the HLS on-chip STDP engine.
    
    Models exactly:
    - weight_memory[N_pre][N_post]: ap_int<8>
    - pre_traces[N_pre], post_traces[N_post]: {trace: uint8, last_spike_time: uint16}
    - pre_eligibility[N_pre], post_eligibility[N_post]: ap_int<8>
    - Lazy update with EXP_DECAY_LUT
    - Mozafari weight-dependent STDP rules
    - R-STDP reward modulation
    """
    
    def __init__(self, n_pre, n_post, a_plus=0.1, a_minus=0.12,
                 rstdp_enable=False):
        self.n_pre = n_pre
        self.n_post = n_post
        
        # Weight memory: signed 8-bit (matching HLS ap_int<8>)
        self.weights = np.zeros((n_pre, n_post), dtype=np.int16)
        # Use int16 for computation to avoid overflow, clamp to [-128, 127]
        
        # Per-neuron traces (matching HLS neuron_trace_t)
        self.pre_trace_val = np.zeros(n_pre, dtype=np.uint8)
        self.pre_trace_time = np.zeros(n_pre, dtype=np.uint16)
        self.post_trace_val = np.zeros(n_post, dtype=np.uint8)
        self.post_trace_time = np.zeros(n_post, dtype=np.uint16)
        
        # Per-neuron eligibility traces (matching HLS ap_int<8>)
        self.pre_eligibility = np.zeros(n_pre, dtype=np.int8)
        self.post_eligibility = np.zeros(n_post, dtype=np.int8)
        
        # Learning parameters (matching HLS learning_params_t)
        # a_plus/a_minus are ap_fixed<16,8> — we convert to int scale
        self.a_plus_int = int(a_plus * 256)    # Fixed-point scale
        self.a_minus_int = int(a_minus * 256)
        self.rstdp_enable = rstdp_enable
        
        # Timestamp counter
        self.timestamp = np.uint16(0)
        
        # Statistics
        self.ltp_count = 0
        self.ltd_count = 0
        self.reward_count = 0
    
    def reset(self):
        """Reset traces and eligibility (matching HLS reset logic)."""
        self.pre_trace_val[:] = 0
        self.pre_trace_time[:] = 0
        self.post_trace_val[:] = 0
        self.post_trace_time[:] = 0
        self.pre_eligibility[:] = 0
        self.post_eligibility[:] = 0
        self.timestamp = np.uint16(0)
    
    def _compute_decayed_trace(self, old_trace, last_time, current_time):
        """
        Exact match of HLS compute_decayed_trace().
        Uses EXP_DECAY_LUT for lazy timestamp-based decay.
        """
        if old_trace == 0:
            return 0
        dt = int(np.uint16(current_time) - np.uint16(last_time))
        if dt < 0:
            dt += 65536  # uint16 wrap
        if dt >= 16:
            return 0
        # new_trace = old_trace * decay_factor / 256
        decayed = (int(old_trace) * int(EXP_DECAY_LUT[dt])) >> 8
        return min(decayed, 255)
    
    def _clip_weight(self, w):
        """Exact match of HLS clip_weight()."""
        return max(MIN_WEIGHT, min(MAX_WEIGHT, int(w)))
    
    def process_pre_spike(self, pre_id):
        """
        Exact match of HLS process_pre_spike_aer().
        
        When pre-neuron fires:
        1. Update pre_trace with lazy decay + new spike
        2. For all post-neurons with post_trace > 0:
           Apply LTD: Δw = -a_minus * (w - w_min) * post_trace / 256
        """
        current_time = self.timestamp
        
        # Step 1: Lazy update pre-trace and add spike
        decayed_pre = self._compute_decayed_trace(
            self.pre_trace_val[pre_id],
            self.pre_trace_time[pre_id],
            current_time
        )
        new_trace = decayed_pre + 128  # Add 0.5 in 8-bit fixed point
        self.pre_trace_val[pre_id] = min(new_trace, 255)
        self.pre_trace_time[pre_id] = current_time
        
        # Step 2: Apply LTD to all synapses from this pre-neuron
        for j in range(self.n_post):
            post_trace = self._compute_decayed_trace(
                self.post_trace_val[j],
                self.post_trace_time[j],
                current_time
            )
            if post_trace == 0:
                continue
            
            current_w = int(self.weights[pre_id, j])
            # Mozafari weight-dependent LTD: Δw = -a_minus * (w - w_min)
            distance = current_w - MIN_WEIGHT  # always >= 0
            delta = -((distance * int(post_trace)) >> 8)
            
            self.weights[pre_id, j] = self._clip_weight(current_w + delta)
            self.ltd_count += 1
    
    def process_post_spike(self, post_id):
        """
        Exact match of HLS process_post_spike_aer().
        
        When post-neuron fires:
        1. Update post_trace with lazy decay + new spike
        2. For all pre-neurons with pre_trace > 0:
           Apply LTP: Δw = +a_plus * (w_max - w) * pre_trace / 256
        """
        current_time = self.timestamp
        
        # Step 1: Lazy update post-trace and add spike
        decayed_post = self._compute_decayed_trace(
            self.post_trace_val[post_id],
            self.post_trace_time[post_id],
            current_time
        )
        new_trace = decayed_post + 128
        self.post_trace_val[post_id] = min(new_trace, 255)
        self.post_trace_time[post_id] = current_time
        
        # Step 2: Apply LTP to all synapses to this post-neuron
        for i in range(self.n_pre):
            pre_trace = self._compute_decayed_trace(
                self.pre_trace_val[i],
                self.pre_trace_time[i],
                current_time
            )
            if pre_trace == 0:
                continue
            
            current_w = int(self.weights[i, post_id])
            # Mozafari weight-dependent LTP: Δw = +a_plus * (w_max - w)
            distance = MAX_WEIGHT - current_w  # always >= 0
            delta = (distance * int(pre_trace)) >> 8
            
            self.weights[i, post_id] = self._clip_weight(current_w + delta)
            self.ltp_count += 1
    
    def update_eligibility_pre(self, pre_id):
        """Exact match of HLS update_eligibility_on_pre_spike()."""
        new_elig = int(self.pre_eligibility[pre_id]) + 32
        self.pre_eligibility[pre_id] = np.int8(min(new_elig, 127))
    
    def update_eligibility_post(self, post_id):
        """Exact match of HLS update_eligibility_on_post_spike()."""
        new_elig = int(self.post_eligibility[post_id]) + 32
        self.post_eligibility[post_id] = np.int8(min(new_elig, 127))
    
    def apply_reward(self, reward_signal):
        """
        Exact match of HLS apply_rstdp_reward().
        W[i][j] += reward * pre_elig[i] * post_elig[j] (shift-approximated)
        """
        if reward_signal == 0 or not self.rstdp_enable:
            return
        
        reward_positive = reward_signal >= 0
        reward_mag = abs(reward_signal)
        
        # Determine shift based on reward magnitude
        if reward_mag >= 64:
            shift = 1
        elif reward_mag >= 32:
            shift = 2
        elif reward_mag >= 16:
            shift = 3
        else:
            shift = 4
        
        for i in range(self.n_pre):
            pre_elig = int(self.pre_eligibility[i])
            if pre_elig == 0:
                continue
            for j in range(self.n_post):
                post_elig = int(self.post_eligibility[j])
                if post_elig == 0:
                    continue
                
                combined = (pre_elig * post_elig) >> 8
                scaled = combined >> shift
                delta = scaled if reward_positive else -scaled
                
                current_w = int(self.weights[i, j])
                self.weights[i, j] = self._clip_weight(current_w + delta)
        
        self.reward_count += 1
    
    def decay_eligibility(self):
        """Exact match of HLS decay_eligibility_traces()."""
        for i in range(self.n_pre):
            t = int(self.pre_eligibility[i])
            self.pre_eligibility[i] = np.int8(t - (t >> 3))  # ≈ 0.875
        for j in range(self.n_post):
            t = int(self.post_eligibility[j])
            self.post_eligibility[j] = np.int8(t - (t >> 3))
    
    def advance_timestamp(self):
        """Advance HLS timestamp counter."""
        self.timestamp = np.uint16(self.timestamp + 1)


# =====================================================================
# On-Chip STDP MNIST Trainer
# =====================================================================

class OnChipSTDPTrainer:
    """
    Trains MNIST using the HLS STDP engine simulator.
    
    Architecture: 784 input → n_output LIF neurons
    Each input pixel is rate-encoded → pre-spikes
    Post-spikes are LIF fires from output neurons
    R-STDP reward: +1 for correct, -1 for wrong
    
    This matches what would happen if you:
    1. Load an image via DMA → delta-sigma encoder → pre-spikes
    2. SNN core fires output neurons → post-spikes
    3. HLS STDP engine updates weights
    4. PS sends reward signal based on correctness
    """
    
    def __init__(self, n_input=784, n_classes=10, features_per_class=10,
                 threshold=3000, timesteps=25, a_plus=0.1, a_minus=0.12,
                 rstdp_enable=True, pixel_threshold=0.3):
        self.n_input = n_input
        self.n_classes = n_classes
        self.features_per_class = features_per_class
        self.n_output = n_classes * features_per_class
        self.threshold = threshold  # LIF threshold (int16 scale)
        self.timesteps = timesteps
        self.pixel_threshold = pixel_threshold
        
        # Decision map (same as SW training)
        self.decision_map = np.array(
            [i // features_per_class for i in range(self.n_output)], dtype=np.int32
        )
        
        # HLS STDP engine
        self.engine = HLSSTDPEngine(
            n_pre=n_input, n_post=self.n_output,
            a_plus=a_plus, a_minus=a_minus,
            rstdp_enable=rstdp_enable
        )
        
        # Initialize weights - random int8 around small positive values
        # Matching HLS: weights start at 0, then get loaded
        # For a meaningful experiment, initialize with small random weights
        self.engine.weights[:, :] = np.random.randint(
            1, 30, size=(n_input, self.n_output), dtype=np.int16
        )
    
    def init_from_sw_model(self, npz_path):
        """
        Initialize weights from SW-trained model (for transfer experiment).
        Loads q_weights from deployment NPZ.
        """
        data = np.load(npz_path)
        q_weights = data['q_weights']  # (n_output, n_input) int8
        # HLS weight_memory is [pre][post], SW model is [post, pre]
        # Transpose: HLS weight_memory[pre_id][post_id]
        self.engine.weights[:, :] = q_weights.T.astype(np.int16)
        self.threshold = int(data['threshold'])
        print(f"  Loaded SW model: weights={q_weights.shape}, threshold={self.threshold}")
        print(f"  Weight range: [{self.engine.weights.min()}, {self.engine.weights.max()}]")
    
    def init_prototypes(self, train_imgs, train_lbls):
        """
        Initialize weights from class prototypes (like SW training).
        Maps float32 [0,1] pixel values to int8 [0, 127] weights.
        """
        for c in range(self.n_classes):
            mask = train_lbls == c
            if not mask.any():
                continue
            class_mean = train_imgs[mask].reshape(-1, self.n_input).mean(axis=0)
            s = c * self.features_per_class
            e = (c + 1) * self.features_per_class
            for f in range(self.features_per_class):
                noise = np.random.randn(self.n_input) * 0.05
                w = np.clip((class_mean + noise) * MAX_WEIGHT * 0.8, 1, MAX_WEIGHT - 10)
                self.engine.weights[:, s + f] = w.astype(np.int16)
        
        print(f"  Prototype init: W=[{self.engine.weights.min()}, {self.engine.weights.max()}]")
    
    def _rate_encode_spikes(self, image):
        """
        Rate-encode an image into spike events (pixel indices and timestamps).
        Returns list of (timestep, pixel_index) tuples.
        """
        pixels = image.flatten()
        spikes = []
        for t in range(self.timesteps):
            for i in range(self.n_input):
                if pixels[i] > self.pixel_threshold:
                    if np.random.rand() < pixels[i]:
                        spikes.append((t, i))
        return spikes
    
    def _lif_forward(self, pre_spikes):
        """
        Simple LIF forward pass matching HLS/RTL: pot += weight, fire on threshold.
        
        Returns: fired neurons list (in fire order), final potentials
        """
        potentials = np.zeros(self.n_output, dtype=np.int32)
        fired = set()
        fire_order = []
        
        for t, pre_id in pre_spikes:
            # For each input spike, accumulate weights to all output neurons
            for j in range(self.n_output):
                if j in fired:
                    continue
                w = int(self.engine.weights[pre_id, j])
                if w > 0:
                    potentials[j] += w
                    if potentials[j] >= self.threshold:
                        fired.add(j)
                        fire_order.append(j)
                        potentials[j] = 0
        
        return fire_order, potentials
    
    def train_one_image(self, image, label, use_rstdp=True):
        """
        Train on a single image using HLS STDP engine.
        
        Simulates the full HLS pipeline:
        1. Rate-encode image → pre-spikes
        2. LIF forward → post-spikes (output fires)
        3. For each pre-spike: process_pre_spike_aer (LTD)
        4. For each post-spike: process_post_spike_aer (LTP)
        5. Eligibility updates on spike events
        6. R-STDP: apply reward based on classification correctness
        7. Decay eligibility traces
        
        Returns: predicted class
        """
        # Reset traces at start of each image (simulating timestamp-separated)
        self.engine.reset()
        
        # 1. Rate-encode
        pre_spikes = self._rate_encode_spikes(image)
        
        # 2. LIF forward
        fire_order, potentials = self._lif_forward(pre_spikes)
        
        # 3. Classify
        if fire_order:
            winner = fire_order[0]
        else:
            winner = int(np.argmax(potentials))
        prediction = int(self.decision_map[winner])
        
        # 4-6. STDP update (only on relevant spikes for efficiency)
        # In real HLS, ALL pre-spikes trigger process_pre_spike_aer
        # and ALL post-spikes trigger process_post_spike_aer.
        # For efficiency, we process the most impactful ones.
        
        # Process pre-spikes (active inputs)
        active_pixels = set()
        for t, pre_id in pre_spikes:
            active_pixels.add(pre_id)
        
        # Only process unique active pre-neurons (not every spike)
        for pre_id in active_pixels:
            self.engine.process_pre_spike(pre_id)
            self.engine.update_eligibility_pre(pre_id)
            self.engine.advance_timestamp()
        
        # Process post-spikes (fired output neurons)
        for post_id in fire_order[:5]:  # Limit to top 5 fires for efficiency
            self.engine.process_post_spike(post_id)
            self.engine.update_eligibility_post(post_id)
            self.engine.advance_timestamp()
        
        # 7. R-STDP reward
        if use_rstdp and self.engine.rstdp_enable:
            if prediction == label:
                reward = 64  # Positive reward
            else:
                reward = -64  # Negative reward
            self.engine.apply_reward(reward)
            self.engine.decay_eligibility()
        
        return prediction
    
    def train_epoch(self, train_imgs, train_lbls, max_samples=None):
        """Train one epoch, return accuracy."""
        n = len(train_imgs) if max_samples is None else min(max_samples, len(train_imgs))
        perm = np.random.permutation(len(train_imgs))[:n]
        
        correct = 0
        per_class_correct = np.zeros(self.n_classes)
        per_class_total = np.zeros(self.n_classes)
        
        for idx in perm:
            pred = self.train_one_image(train_imgs[idx], train_lbls[idx])
            per_class_total[train_lbls[idx]] += 1
            if pred == train_lbls[idx]:
                correct += 1
                per_class_correct[train_lbls[idx]] += 1
        
        acc = correct / n * 100
        return acc, per_class_correct, per_class_total
    
    def test(self, test_imgs, test_lbls, max_samples=None):
        """Test (inference only, no learning)."""
        n = len(test_imgs) if max_samples is None else min(max_samples, len(test_imgs))
        
        correct = 0
        per_class_correct = np.zeros(self.n_classes)
        per_class_total = np.zeros(self.n_classes)
        
        for i in range(n):
            # Reset traces
            self.engine.reset()
            
            # Forward only
            pre_spikes = self._rate_encode_spikes(test_imgs[i])
            fire_order, potentials = self._lif_forward(pre_spikes)
            
            if fire_order:
                winner = fire_order[0]
            else:
                winner = int(np.argmax(potentials))
            prediction = int(self.decision_map[winner])
            
            per_class_total[test_lbls[i]] += 1
            if prediction == test_lbls[i]:
                correct += 1
                per_class_correct[prediction] += 1
        
        acc = correct / n * 100
        return acc, per_class_correct, per_class_total
    
    def get_weight_stats(self):
        """Return weight statistics."""
        w = self.engine.weights
        return {
            'min': int(w.min()),
            'max': int(w.max()),
            'mean': float(w.mean()),
            'std': float(w.std()),
            'zeros': int((w == 0).sum()),
            'saturated_pos': int((w >= MAX_WEIGHT).sum()),
            'saturated_neg': int((w <= MIN_WEIGHT).sum()),
        }


# =====================================================================
# Data Loading
# =====================================================================

def load_mnist(data_dir='./data', max_train=None, max_test=None):
    """Load MNIST using torchvision."""
    from torchvision import datasets, transforms
    transform = transforms.Compose([transforms.ToTensor()])
    train_ds = datasets.MNIST(data_dir, train=True, download=True, transform=transform)
    test_ds = datasets.MNIST(data_dir, train=False, download=True, transform=transform)
    
    def to_numpy(ds, max_n=None):
        imgs, lbls = [], []
        for img, lbl in ds:
            imgs.append(img.numpy().squeeze())
            lbls.append(lbl)
            if max_n and len(imgs) >= max_n:
                break
        return np.array(imgs), np.array(lbls)
    
    train_imgs, train_lbls = to_numpy(train_ds, max_train)
    test_imgs, test_lbls = to_numpy(test_ds, max_test)
    return train_imgs, train_lbls, test_imgs, test_lbls


# =====================================================================
# Main Experiment
# =====================================================================

def main():
    ap = argparse.ArgumentParser(description='On-Chip STDP Experiment (HLS Bit-Accurate)')
    ap.add_argument('--neurons', type=int, default=10, help='Features per class')
    ap.add_argument('--epochs', type=int, default=5, help='Training epochs')
    ap.add_argument('--train-samples', type=int, default=5000, help='Train samples per epoch')
    ap.add_argument('--test-samples', type=int, default=1000, help='Test samples')
    ap.add_argument('--timesteps', type=int, default=25, help='Timesteps per image')
    ap.add_argument('--threshold', type=int, default=3000, help='LIF threshold (int scale)')
    ap.add_argument('--a-plus', type=float, default=0.1, help='LTP amplitude')
    ap.add_argument('--a-minus', type=float, default=0.12, help='LTD amplitude')
    ap.add_argument('--rstdp', action='store_true', help='Enable R-STDP')
    ap.add_argument('--prototype-init', action='store_true', help='Init from class prototypes')
    ap.add_argument('--sw-model', type=str, default=None,
                    help='Initialize from SW-trained model NPZ')
    ap.add_argument('--seed', type=int, default=42)
    args = ap.parse_args()
    
    np.random.seed(args.seed)
    n_output = args.neurons * 10
    
    print("=" * 70)
    print("On-Chip STDP Experiment (HLS Bit-Accurate Simulation)")
    print("=" * 70)
    print(f"  Architecture: 784 → {n_output} ({args.neurons}/class × 10)")
    print(f"  Threshold: {args.threshold}  Timesteps: {args.timesteps}")
    print(f"  A+={args.a_plus}  A-={args.a_minus}  R-STDP={'ON' if args.rstdp else 'OFF'}")
    print(f"  Train: {args.train_samples}/epoch  Test: {args.test_samples}")
    print(f"  Epochs: {args.epochs}")
    print(f"  Weight: signed 8-bit [{MIN_WEIGHT}, {MAX_WEIGHT}]")
    print(f"  Traces: Per-neuron (O(N+M)), lazy decay LUT")
    
    # Load data
    print("\n[1] Loading MNIST...")
    train_imgs, train_lbls, test_imgs, test_lbls = load_mnist(
        max_train=args.train_samples * 2,  # Extra for prototype init
        max_test=args.test_samples
    )
    print(f"  Train: {len(train_imgs)}, Test: {len(test_imgs)}")
    
    # Create trainer
    print("\n[2] Creating HLS STDP engine...")
    trainer = OnChipSTDPTrainer(
        n_input=784, n_classes=10, features_per_class=args.neurons,
        threshold=args.threshold, timesteps=args.timesteps,
        a_plus=args.a_plus, a_minus=args.a_minus,
        rstdp_enable=args.rstdp
    )
    
    # Weight initialization
    if args.sw_model:
        print(f"  Loading SW model from {args.sw_model}...")
        trainer.init_from_sw_model(args.sw_model)
    elif args.prototype_init:
        print("  Initializing with class prototypes...")
        trainer.init_prototypes(train_imgs, train_lbls)
    else:
        print(f"  Random init: W=[{trainer.engine.weights.min()}, {trainer.engine.weights.max()}]")
    
    # Pre-training test
    print("\n[3] Pre-training test...")
    t0 = time.time()
    pre_acc, _, _ = trainer.test(test_imgs, test_lbls, max_samples=min(500, args.test_samples))
    dt = time.time() - t0
    print(f"  Pre-training accuracy: {pre_acc:.1f}% ({dt:.1f}s)")
    
    # Training
    print(f"\n[4] Training ({args.epochs} epochs, {args.train_samples} samples/epoch)...")
    best_acc = pre_acc
    
    for epoch in range(args.epochs):
        t0 = time.time()
        train_acc, pc_correct, pc_total = trainer.train_epoch(
            train_imgs, train_lbls, max_samples=args.train_samples
        )
        dt = time.time() - t0
        
        ws = trainer.get_weight_stats()
        ca_min = 0
        ca_max = 0
        for c in range(10):
            if pc_total[c] > 0:
                ca = pc_correct[c] / pc_total[c] * 100
                if c == 0 or ca < ca_min:
                    ca_min = ca
                if c == 0 or ca > ca_max:
                    ca_max = ca
        
        print(f"  Epoch {epoch:2d}: TrainAcc={train_acc:5.1f}%  "
              f"W=[{ws['min']},{ws['max']}] μ={ws['mean']:.1f}  "
              f"ClassAcc=[{ca_min:.0f}%-{ca_max:.0f}%]  "
              f"LTP={trainer.engine.ltp_count} LTD={trainer.engine.ltd_count}  "
              f"({dt:.0f}s)")
        
        # Reset counters each epoch
        trainer.engine.ltp_count = 0
        trainer.engine.ltd_count = 0
        
        # Periodic test
        if (epoch + 1) % 2 == 0 or epoch == args.epochs - 1:
            test_acc, tpc, tpt = trainer.test(
                test_imgs, test_lbls, max_samples=args.test_samples
            )
            if test_acc > best_acc:
                best_acc = test_acc
            print(f"         TestAcc={test_acc:.1f}%  (best={best_acc:.1f}%)")
            for c in range(10):
                if tpt[c] > 0:
                    print(f"           Class {c}: {int(tpc[c])}/{int(tpt[c])} = {tpc[c]/tpt[c]*100:.0f}%")
    
    # Final test
    print(f"\n[5] Final test ({args.test_samples} images)...")
    final_acc, pc_c, pc_t = trainer.test(test_imgs, test_lbls)
    
    # Summary
    print("\n" + "=" * 70)
    print("ON-CHIP STDP EXPERIMENT RESULTS")
    print("=" * 70)
    print(f"  Architecture:      784 → {n_output} ({args.neurons}/class × 10)")
    print(f"  Weight type:       signed 8-bit [{MIN_WEIGHT}, {MAX_WEIGHT}]")
    print(f"  Trace type:        Per-neuron (O(N+M)), lazy decay LUT")
    print(f"  STDP rule:         Mozafari weight-dependent")
    print(f"  R-STDP:            {'Enabled' if args.rstdp else 'Disabled'}")
    print(f"  Pre-training acc:  {pre_acc:.1f}%")
    print(f"  Best test acc:     {best_acc:.1f}%")
    print(f"  Final test acc:    {final_acc:.1f}%")
    ws = trainer.get_weight_stats()
    print(f"  Final weights:     [{ws['min']}, {ws['max']}] μ={ws['mean']:.1f} σ={ws['std']:.1f}")
    print(f"  Saturated:         +{ws['saturated_pos']} / -{ws['saturated_neg']}")
    print()
    print("  Per-class accuracy:")
    for c in range(10):
        if pc_t[c] > 0:
            print(f"    Class {c}: {int(pc_c[c])}/{int(pc_t[c])} = {pc_c[c]/pc_t[c]*100:.0f}%")
    
    print()
    print("  Comparison with SW STDP (competitive R-STDP):")
    print("    SW Float32 WTA:   87.7%")
    print("    SW Int8 SW-LIF:   84.0%")
    print(f"    HLS On-Chip STDP: {final_acc:.1f}%")
    
    return final_acc


if __name__ == "__main__":
    main()
