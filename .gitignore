# ============================================================
# Data / Models / Outputs
# ============================================================

# Keep directory structure with .gitkeep
data/*
!data/.gitkeep
models/*
!models/.gitkeep
software/python/data/
*.pth
*.pt
*.onnx
*.npz
*.npy

# Outputs are generated build artifacts. Release bundles collect the selected
# bit/HWH/report set explicitly instead of tracking ad-hoc local outputs.
outputs/*
!outputs/.gitkeep
fpga.zip

# Local dataset/download/profiling snapshots. Keep these out of release commits;
# curated traces and reports capture the reproducible evidence.
drive-download-*.zip
profiler_*.json

